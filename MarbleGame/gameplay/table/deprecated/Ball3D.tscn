[sub_resource type="Shader" id="Shader_outline"]
code = "shader_type spatial;
render_mode unshaded, cull_front;
uniform vec4 outline_color : source_color = vec4(0, 0, 0, 1);
uniform float outline_width : hint_range(0, 1) = 0.05;
void vertex() {
	VERTEX += NORMAL * outline_width;
}
void fragment() {
	ALBEDO = outline_color.rgb;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_outline"]
